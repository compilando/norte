{
  "permissions": {
    "allow": [
      "Bash(cargo build*)", "Bash(cargo nextest*)", "Bash(cargo clippy*)",
      "Bash(cargo fmt*)", "Bash(cargo doc*)", "Bash(cargo llvm-cov*)",
      "Bash(cargo deny*)", "Bash(just *)", "Bash(git status*)", "Bash(git diff*)",
      "Bash(git log*)", "Bash(git add*)", "Bash(git commit*)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(rm -rf /*)", "Read(.env*)",
      "Read(**/secrets/**)", "Bash(curl * | sh)", "Bash(cargo publish*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command",
          "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.rs) command -v cargo >/dev/null && cargo fmt -- \"$f\" 2>/dev/null || true;; esac" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [{ "type": "command",
          "command": "[ -f Cargo.toml ] || exit 0; cargo clippy --workspace --all-targets -q -- -D warnings && cargo nextest run --workspace -q" }]
      }
    ]
  }
}
