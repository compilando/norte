# Copy to config.env and fill in local paths. config.env is ignored by Git.
# The ISO must come from Microsoft or your licensed installation media.
NORTE_WINDOWS_ISO=/absolute/path/to/Windows11.iso
NORTE_WINDOWS_ISO_SHA256=replace_with_the_64_hex_digit_digest

# Everything below has a safe default.
# NORTE_LAB_HOME=/home/you/work/norte-lab
# NORTE_WINDOWS_VM_NAME=norte-win11-build
# 16 GiB was the first default; on a 31 GiB host it left the host's own
# desktop less than the guest's peak and the OOM killer took QEMU three
# times. 10 GiB builds the whole workspace including the Tauri window.
# NORTE_WINDOWS_MEMORY_MIB=10240
# NORTE_WINDOWS_VCPUS=8
# NORTE_WINDOWS_DISK_GIB=160
# NORTE_WINDOWS_USER=norte
# Set this to an exact image name from the ISO catalog.
# NORTE_WINDOWS_IMAGE_NAME="Windows 11 Pro"
# Set this to a language present in the selected image.
# NORTE_WINDOWS_LOCALE=en-US
# Generic installation key; selects Pro but does not activate Windows.
# NORTE_WINDOWS_PRODUCT_KEY=W269N-WFGWX-YVC9B-4J6C9-T83GX
# NORTE_LIBVIRT_QEMU_USER=libvirt-qemu
