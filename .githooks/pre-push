#!/usr/bin/env bash
# El suelo: nada sale de esta máquina sin pasar el gate.
#
# Existe porque un gate que depende de que alguien se acuerde se pudre. El
# 2026-09-01 `just gui-ci` llevaba SEMANAS rojo en `main` de dos formas
# distintas —una función pasada del umbral del lint, y un test que no
# compilaba desde que `UiHostOptions` ganó un campo— y nadie lo sabía porque
# se corría a mano (ADR 0087).
#
# CALLADO A PROPÓSITO. Un hook que vuelca la salida entera del gate es peor
# que no tenerlo: entierra el resultado y, si al otro lado hay un asistente,
# se le come la ventana de contexto. Verde = una línea. Rojo = la cola del
# fallo y la ruta del log completo.
#
# Se salta con `git push --no-verify` cuando hace falta, que es lo correcto:
# esto es un suelo, no una cerradura.
#
# Se instala con `just hooks` (pone `core.hooksPath`).
set -uo pipefail

# Un borrado de rama no construye nada.
todo_borrados=1
refs=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" =~ ^0+$ ]] && continue
    todo_borrados=0
    refs+=("$local_sha $remote_sha")
done
[[ $todo_borrados -eq 1 ]] && exit 0

RAIZ="$(git rev-parse --show-toplevel)"
cd "$RAIZ" || exit 1

# Git exporta a sus hooks las variables que fijan EL repositorio (#364). El
# gate hereda el entorno, y un test que lanzaba `git init/config/commit` en su
# tempdir operaba sobre ESTE repo: dejó en `main` un commit «uno» que borraba
# todo y `user.name = t` en `.git/config`, y el test fallaba solo aquí. Desde
# `cd "$RAIZ"` el repositorio se deduce del directorio, así que no hacen falta.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE GIT_PREFIX

# Lo que este push SUBE, no lo que difiere de `origin/main`: con `main` por
# delante del remoto, esa comparación metía commits ajenos a la rama y
# disparaba `gui-ci` por un `justfile` que no era de este push. Una rama nueva
# sube lo que ningún remoto tiene aún. `-m` lista las fusiones contra cada
# padre: sobra, pero sobrar solo cuesta un gate.
cambiados="$(
    for r in "${refs[@]}"; do
        read -r local_sha remote_sha <<<"$r"
        if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            git log -m --format= --name-only "$remote_sha..$local_sha"
        else
            git log -m --format= --name-only "$local_sha" --not --remotes
        fi
    done | sort -u | sed '/^$/d'
)"

# Solo prosa e imágenes: nada que el gate compile ni lea. `docs/schema/` queda
# fuera porque `norte-proto` lo compara en sus tests, y todo `crates/` porque
# `norte-help` hace `include_str!` de sus `.md`.
inerte='^(docs/|[^/]+\.md$|\.github/(ISSUE_TEMPLATE/|PULL_REQUEST_TEMPLATE))'
if ! grep -vE "$inerte" <<<"$cambiados" | grep -q . \
    && ! grep -q '^docs/schema/' <<<"$cambiados"; then
    echo "pre-push: solo documentación, sin gate"
    exit 0
fi

# SELLO: el árbol que ya pasó el gate.
#
# Un suelo que cuesta veinte minutos se convierte en un `--no-verify` de
# costumbre, y entonces no es un suelo. Ya pasó: el push que trajo estos
# commits tardó tanto que hubo que saltarlo — habiendo corrido `just ci`
# entero, cobertura incluida, cinco minutos antes.
#
# El sello es el hash del CONTENIDO seguido por git, tal como está en el disco
# — no `HEAD^{tree}`. La primera versión usaba eso y no servía en el flujo
# normal: al correr el gate los cambios aún no están commiteados, así que
# sellaba el árbol del commit anterior. Lo demostró el primer push que lo usó.
#
# Así, reordenar commits o cambiar un mensaje no invalida nada, y cambiar un
# byte de código sí. Correr `just ci` (o `ci-fast`) y empujar a continuación es
# instantáneo; solo paga quien no lo corrió.
# DOS sellos, y eso es lo que arregla un agujero que este hook tuvo: `just ci`
# EXCLUYE la ventana (`--exclude norte-gui-tauri`), así que su sello no dice
# nada de `gui-ci`. Con un solo sello, correr `just ci` y empujar un cambio de
# la ventana salía por el atajo de arriba y se saltaba `gui-ci` en silencio —
# exactamente lo que este hook existe para que no pase (ver la cabecera). Se
# comprobó en dos pushes seguidos que tocaban `render/*.ts`.
SELLO="$RAIZ/target/.norte-gate-ok"
SELLO_GUI="$RAIZ/target/.norte-gui-gate-ok"
HUELLA="$(git ls-files -z | xargs -0 sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1)"

sellado() {
    [[ -f "$1" ]] && [[ "$(cat "$1" 2>/dev/null)" == "$HUELLA" ]]
}

# ¿El push toca la ventana, o algo que entra en ella? Es la misma lista que
# `.github/workflows/gui.yml`, y por el mismo motivo: un cambio en
# `norte-ui-host` puede romper la ventana mientras el gate portable sigue
# verde.
toca_ventana=0
if grep -qE \
    '^(crates/norte-(gui-tauri|ui-host|client|frontend|proto)/|Cargo\.(toml|lock)$|justfile$)' \
    <<<"$cambiados"; then
    toca_ventana=1
fi

if sellado "$SELLO" && { [[ $toca_ventana -eq 0 ]] || sellado "$SELLO_GUI"; }; then
    echo "pre-push: el gate ya pasó sobre este contenido (${HUELLA:0:8})"
    exit 0
fi

LOG="$(mktemp -t norte-prepush-XXXXXX.log)"

corre() {
    local nombre="$1"; shift
    printf '  %-10s ' "$nombre"
    if "$@" >>"$LOG" 2>&1; then
        printf '\033[32mok\033[0m\n'
        return 0
    fi
    printf '\033[31mROJO\033[0m\n'
    return 1
}

echo "pre-push: log en $LOG (tail -f para seguirlo)"
fallo=0
sellado "$SELLO" || corre "ci-fast" just ci-fast || fallo=1

if [[ $toca_ventana -eq 1 ]] && ! sellado "$SELLO_GUI"; then
    corre "gui-ci" just gui-ci || fallo=1
fi

if [[ $fallo -eq 0 ]]; then
    rm -f "$LOG"
    # Se sella lo que acaba de pasar, para que un segundo push del mismo árbol
    # no vuelva a pagarlo. Va en `target/`, que no se versiona ni se comparte:
    # el sello vale para ESTA máquina y este contenido, que es lo que se
    # comprobó.
    mkdir -p "$(dirname "$SELLO")" 2>/dev/null || true
    printf '%s\n' "$HUELLA" >"$SELLO" 2>/dev/null || true
    if [[ $toca_ventana -eq 1 ]]; then
        printf '%s\n' "$HUELLA" >"$SELLO_GUI" 2>/dev/null || true
    fi
    exit 0
fi

echo
echo "--- cola del fallo ---"
tail -n 30 "$LOG"
echo "----------------------"
echo "log completo: $LOG"
echo "si sabes lo que haces: git push --no-verify"
exit 1
