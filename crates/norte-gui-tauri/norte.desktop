[Desktop Entry]
Type=Application
Name=norte
GenericName=File Manager
Comment=norte, gestor de ficheros ortodoxo
# `%f` and NOT `%U`: `%U` delivers a URL (`file:///home`) and `norte-gui`
# expects a PATH — `PathBuf::from("file:///home")` is a RELATIVE path that
# doesn't exist, so the window would open on an error instead of the folder
# the desktop just named. `%f` delivers the local path, which is what this
# binary knows how to read.
Exec=norte-gui %f
Icon=norte-gui
Terminal=false
StartupWMClass=norte-gui
# ONE main category (`System`) and the two additional ones that describe what
# it is: with two main categories, `desktop-file-validate` warns that the
# application can show up TWICE in the menu. `FileManager` is what makes the
# desktop offer norte in "open folder with…"; only `Utility` — what the
# bundler generates by default — left it in the miscellaneous drawer and out
# of that list.
Categories=System;FileTools;FileManager;
# A directory. Without this, "open with…" on a folder doesn't offer norte,
# which for a file manager is the entire integration. Without
# `x-directory/normal`: it's an old type the validator discourages, and the
# remaining desktops understand `inode/directory`.
MimeType=inode/directory;
Keywords=file;manager;explorer;ficheros;archivos;
