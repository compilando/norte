[Desktop Entry]
Type=Application
Name=norte
GenericName=File Manager
Comment=norte, gestor de ficheros ortodoxo
# `%f` y NO `%U`: `%U` entrega una URL (`file:///casa`) y `norte-gui` espera
# una RUTA — `PathBuf::from("file:///casa")` es una ruta RELATIVA que no
# existe, así que la ventana abriría sobre un error en vez de sobre la carpeta
# que el escritorio acaba de nombrar. `%f` entrega la ruta local, que es lo
# que este binario sabe leer.
Exec=norte-gui %f
Icon=norte-gui
Terminal=false
StartupWMClass=norte-gui
# UNA categoría principal (`System`) y las dos adicionales que describen qué
# es: con dos principales, `desktop-file-validate` avisa de que la aplicación
# puede salir DOS VECES en el menú. `FileManager` es lo que hace que el
# escritorio ofrezca norte en «abrir carpeta con…»; solo `Utility` —lo que el
# bundler genera por defecto— lo dejaba en el cajón de sastre y fuera de esa
# lista.
Categories=System;FileTools;FileManager;
# Un directorio. Sin esto, «abrir con…» sobre una carpeta no ofrece norte, que
# para un gestor de ficheros es la integración entera. Sin
# `x-directory/normal`: es un tipo viejo que el validador desaconseja, y los
# escritorios que quedan entienden `inode/directory`.
MimeType=inode/directory;
Keywords=file;manager;explorer;ficheros;archivos;
