{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "norte",
  "identifier": "dev.norte.gui",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "norte",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "visible": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src ipc:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; manifest-src 'none'; media-src 'none'; worker-src 'none'",
      "freezePrototype": true,
      "capabilities": [
        "main"
      ],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "externalBin": [
      "binaries/norte",
      "binaries/ntc"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "norte, gestor de ficheros ortodoxo",
    "longDescription": "Un gestor de ficheros de dos paneles con un núcleo sin interfaz, un daemon y acceso para agentes. Esta es la ventana; el paquete trae también el daemon y el cliente de terminal.",
    "linux": {
      "deb": {
        "desktopTemplate": "norte.desktop"
      },
      "rpm": {
        "desktopTemplate": "norte.desktop",
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  }
}
