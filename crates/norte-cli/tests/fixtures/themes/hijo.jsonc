{
	// Hand-written for `theme_import.rs`: the shape of a marketplace theme,
	// with what breaks a strict JSON reader.
	"$schema": "vscode://schemas/color-theme",
	"name": "My Theme: Night",
	"include": "./padre.json",
	"colors": {
		"editor.background": "#101820",
		/* a color with alpha, composited over the background */
		"scrollbarSlider.background": "#ffffff40",
		"focusBorder": "#ff8800",
		"foreground": "#E0E0E0",
		"badge.background": "not a color",
	},
	"tokenColors": [
		{ "scope": "comment", "settings": { "foreground": "#666666" } }, // ignored
	],
}
