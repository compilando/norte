"┌⟨file⟩/casa───────────────────────────┐┌⟨file⟩/otro───────────────────────────┐"
"│N┌ Ayuda — teclas activas — [esc/q/f1] cerrar   [↑/↓/pgup/pgdn] desplazar ──┐a│"
"│ │  ctrl+h         mostrar u ocultar entradas ocultas                       │ │"
"│ │  alt+.          mostrar u ocultar entradas ocultas                       │ │"
"│ │  alt+c          selector de columnas                                     │ │"
"│ │  ctrl+d         directorios favoritos                                    │ │"
"│ │  insert         marcar/desmarcar la entrada bajo el cursor               │ │"
"│ │  ctrl+a         marcar todas las entradas visibles                       │ │"
"│ │  ctrl+A         quitar todas las marcas                                  │ │"
"│ │  *              invertir las marcas                                      │ │"
"│ │  plus           marcar por patrón                                        │ │"
"│ │  -              desmarcar por patrón                                     │ │"
"│ │  q              salir de norte                                           │ │"
"│ │  f10            salir de norte                                           │ │"
