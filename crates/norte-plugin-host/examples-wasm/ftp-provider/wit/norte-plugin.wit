// Versionado: 0.1.0 → 0.2.0 añadió la interfaz `provider` + world
// `norte-provider` (#30 stage 2); 0.2.0 → 0.3.0 añadió el camino de escritura
// (writer resource + open-writer/make-dir/remove/rename); 0.3.0 → 0.4.0 añadió
// `configure` a `provider` (#30 stage 3c): un provider que ESTABLECE SU PROPIA
// conexión (FTP sobre wasi:sockets) recibe endpoint+credenciales+base. Para
// previewer/command/host-log es ADITIVO (no cambian). Para un GUEST de
// `provider` es ROMPEDOR (un guest a 0.3.0 ya no satisface el world 0.4.0: le
// falta el export `configure`); es seguro porque `provider` es pre-release y no
// hay guests publicados — el bump de minor bajo 0.x codifica exactamente
// "ruptura permitida". `provider` (en evolución) comparte paquete con el estable
// porque el wit-parser del árbol (0.239) no soporta paquetes anidados; cuando se
// estabilice se separa a su propio paquete vía layout `wit/deps/`
// (protocol-guardian; ADR 0032).
package norte:plugin@0.4.0;

/// La puerta de host MÍNIMA (demuestra el gating host↔guest): un plugin puede
/// pedir al host que registre una línea de log (inocua, sin capability) y leer
/// un recurso que el host abrió bajo `fs-read=scoped` (gateado en el HOST).
interface host-log {
    log: func(message: string);

    /// Lee un recurso que el host preparó y referenció con `token`
    /// (fs-read=scoped). Si el plugin NO declaró fs-read, el host devuelve
    /// Err — el enforcement vive en el HOST, no en el guest (ADR 0022 D4).
    read-scoped: func(token: string) -> result<list<u8>, string>;
}

/// Genera una previsualización de UN recurso que el HOST ya leyó y le pasa
/// (regla 9: el guest jamás toca el FS; recibe los bytes). Devuelve texto
/// plano listo para pintar, o un error legible.
interface previewer {
    record preview-input {
        /// Mimetype detectado por el host.
        mimetype: string,
        /// Contenido del recurso (el host lo leyó bajo fs-read=scoped).
        content: list<u8>,
    }
    render: func(input: preview-input) -> result<string, string>;
}

/// Ejecuta un comando aportado por el plugin. `arg` es texto libre del
/// invocador; devuelve un mensaje para la barra de estado, o un error.
interface command {
    run: func(id: string, arg: string) -> result<string, string>;
}

/// El world que un plugin de norte implementa. Un plugin concreto exporta las
/// interfaces de su categoría; en M4-P2 el world exige AMBAS (`previewer` y
/// `command`) — un guest de una sola categoría implementa la otra como
/// no-soportada. Worlds por-categoría = deuda P2b.
world norte-plugin {
    import host-log;
    export previewer;
    export command;
}

/// Interfaz `provider` (#30, ADR 0032): proyección SÍNCRONA del trait
/// `norte_vfs::Provider`. El streaming async se proyecta a llamadas ACOTADAS
/// (list paginado, read por rango) que el host reensambla. Paths y nombres
/// cruzan como BYTES CRUDOS (regla 1) — un path es su lista de segmentos, cada
/// segmento su lista de bytes; jamás un `string`. STAGE 2 = solo-lectura, sin
/// red: de-risk de la proyección.
interface provider {
    /// Tipo de una entrada del árbol.
    enum entry-kind { file, dir, symlink, other }

    /// Una entrada listada/consultada. `name` en bytes crudos (regla 1).
    record entry {
        name: list<u8>,
        kind: entry-kind,
        size: option<u64>,
    }

    /// Error del provider: proyección de `norte_proto::Error`. Se incluyen las
    /// variantes relevantes al camino de lectura para que la taxonomía NO se
    /// pierda (review): `cursor-expired` (la paginación lo necesita),
    /// `provider-unavailable` (transitorio remoto, stage 3), `loop` (symlinks).
    /// El flag `retryable` de `io`/`provider-unavailable` se difiere a stage 3
    /// (exigiría un `variant`, no un `enum`). `other` = variante conocida aún
    /// no mapeada — un `enum` WIT es CERRADO, no absorbe variantes futuras (a
    /// diferencia del `Unknown` de proto): añadir una es un cambio de wire.
    enum vfs-error {
        not-found,
        permission-denied,
        unsupported,
        invalid-path,
        io,
        corrupt,
        cursor-expired,
        provider-unavailable,
        %loop,
        conflict,
        no-space,
        other,
    }

    /// Capabilities proyectadas (stage 2: solo el flag de solo-lectura; el set
    /// completo llega con el camino de escritura).
    record caps {
        read-only: bool,
    }

    /// Una página de entradas + el cursor OPACO de la siguiente (`none` = fin).
    /// El cursor es `list<u8>` (bytes opacos, como el token expirable de #27) —
    /// NO un índice: un provider remoto (continuación S3/FTP) no cabe en un u32.
    record page {
        entries: list<entry>,
        next-cursor: option<list<u8>>,
    }

    /// Capabilities del provider.
    capabilities: func() -> caps;

    /// Metadatos de una entrada (equiv. `Provider::stat`).
    stat: func(segments: list<list<u8>>) -> result<entry, vfs-error>;

    /// Lista PAGINADA (equiv. `Provider::list`): una página + el cursor opaco de
    /// la siguiente. El host reensambla el `EntryStream` llamando en bucle.
    /// (`list` es palabra reservada del WIT — de ahí `list-dir`.)
    list-dir: func(segments: list<list<u8>>, cursor: option<list<u8>>) -> result<page, vfs-error>;

    /// Lee un RANGO acotado (equiv. una porción del `ByteStream`): a lo sumo
    /// `len` bytes desde `offset`. Un chunk más corto que `len` = EOF.
    read: func(segments: list<list<u8>>, offset: u64, len: u64) -> result<list<u8>, vfs-error>;

    /// Configuración de un provider que ESTABLECE SU PROPIA conexión (#30 stage
    /// 3c, FTP). El HOST resuelve el hostname a IP, concede la capability `net`
    /// acotada a esa IP y llama a `configure` con el endpoint YA resuelto
    /// (`ip:puerto`) — el guest jamás resuelve DNS. Las credenciales cruzan a la
    /// memoria del guest (sandbox aislado): imprescindibles para el `login`;
    /// sobre FTP en claro (FTPS = deuda, aws-lc-rs no compila a wasm) ya viajan
    /// sin cifrar por el cable. `base` = raíz remota absoluta bajo la que vive
    /// todo. Un provider que no necesita conexión (mem) lo implementa como no-op.
    record provider-config {
        /// Endpoint YA resuelto por el host: `ip:puerto`.
        endpoint: string,
        /// Usuario de login (`anonymous` por convención guest).
        user: string,
        /// Password de login (viaja a memoria del guest para autenticar).
        password: string,
        /// Raíz remota absoluta (sin `..`, sin barra final significativa).
        base: string,
    }
    configure: func(cfg: provider-config) -> result<_, vfs-error>;

    /// Escritura TRANSACCIONAL (#30 stage 2b-write): proyección de
    /// `norte_vfs::ByteSink`. `open-writer` devuelve un `writer` (staging propio
    /// del guest; el path final NO existe hasta `commit`); `write` añade un
    /// chunk; `commit` publica atómicamente; `abort` descarta el staging. Soltar
    /// el `writer` sin commit debe limpiar (best-effort). El host reensambla el
    /// `ByteSink` sobre este recurso.
    resource writer {
        write: func(chunk: list<u8>) -> result<_, vfs-error>;
        commit: func() -> result<_, vfs-error>;
        abort: func() -> result<_, vfs-error>;
    }

    /// Abre un `writer` transaccional sobre el path (equiv. `Provider::write`).
    open-writer: func(segments: list<list<u8>>) -> result<writer, vfs-error>;

    /// Crea un directorio (equiv. `Provider::mkdir`).
    make-dir: func(segments: list<list<u8>>) -> result<_, vfs-error>;

    /// Borra una entrada (equiv. `Provider::remove`).
    remove: func(segments: list<list<u8>>) -> result<_, vfs-error>;

    /// Renombra/mueve (equiv. `Provider::rename`). (`from`/`to` son palabras
    /// reservadas del WIT — de ahí `src`/`dst`.)
    rename: func(src: list<list<u8>>, dst: list<list<u8>>) -> result<_, vfs-error>;
}

/// World de un plugin-provider (#30 stage 2): expone `provider` e importa
/// `host-log`. Separado de `norte-plugin` — un guest de provider no implementa
/// previewer/command.
world norte-provider {
    import host-log;
    export provider;
}
