// Versionado: 0.1.0 → 0.2.0 añadió la interfaz `provider` + world
// `norte-provider` (#30 stage 2); 0.2.0 → 0.3.0 añadió el camino de escritura
// (writer resource + open-writer/make-dir/remove/rename); 0.3.0 → 0.4.0 (#30
// stage 3c) tiene DOS rupturas para un guest de `provider`, ambas cubiertas por
// el único bump (0.4.0 nunca se publicó):
//   1. `configure(provider-config)`: un provider que ESTABLECE SU PROPIA
//      conexión (FTP sobre wasi:sockets) recibe endpoint+credenciales+base. Un
//      guest a 0.3.0 no exporta `configure` → no satisface el world 0.4.0.
//   2. `caps` pasó de 1 a 3 campos (`case-sensitive`, `case-preserving`): los
//      records WIT no tienen campos opcionales ni defaults, así que cambia la
//      forma canónica-ABI de `capabilities() -> caps` — ROMPEDOR por sí solo.
// Es seguro porque `provider` es pre-release y no hay guests publicados — el bump
// de minor bajo 0.x codifica exactamente "ruptura permitida".
// AVISO (no del todo aditivo para el resto): previewer/command/host-log no
// cambian de TEXTO, pero la versión del paquete viaja en cada nombre de interfaz
// versionado (`norte:plugin/previewer@0.4.0`…). Bajo el semver de wasmtime para
// 0.x, un guest de terceros previewer/command compilado contra `@0.3.0` NO
// instancia en el host 0.4.0. Es la deuda conocida del paquete compartido (ADR
// 0032): cuando `provider` se estabilice se separa a su propio paquete vía
// layout `wit/deps/` (el wit-parser del árbol, 0.239, no soporta paquetes
// anidados), y solo entonces la superficie estable deja de romperse con
// `provider`. protocol-guardian.
//
// 0.4.0 → 0.5.0 (P2 Task 3): añade la interfaz `host-config` (settings
// VALIDADAS de `[config]`, P2) importada por AMBOS worlds. Es aditiva SOLO en
// el sentido estrecho de LINKING wasmtime: el `Linker` del host puede ofrecer
// una función más de las que un componente concreto importa sin que eso, por
// sí mismo, rompa nada (un import de más en el linker nunca es el problema;
// solo un import NO resuelto lo es). Pero el MISMO "AVISO" de arriba se aplica
// igual de fuerte aquí, y no es solo teórico: VERIFICADO empíricamente para
// este bump — un `.wasm` de `command-demo` compilado ANTES de este cambio
// (paquete 0.4.0, sin `host-config`) fue probado contra el host YA en 0.5.0 y
// la instanciación FALLA:
//   "component imports instance `norte:plugin/host-log@0.4.0`, but a matching
//   implementation was not found in the linker"
// Es decir, el guest viejo pide `host-log@0.4.0` (el nombre versionado que
// llevaba grabado al compilar) y el linker del host 0.5.0 solo ofrece
// `host-log@0.5.0` — rompe por el LADO DE IMPORT, no solo el de export como
// advertía el análisis original. Confirma la deuda del paquete compartido
// (ADR 0032): CUALQUIER bump de este `package` invalida TODOS los artefactos
// `.wasm` ya compilados, aditivo o no en su contenido textual. Dentro de este
// repo no importa (los guests de `examples-wasm/` se recompilan siempre desde
// el WIT actual, vía symlink) — importaría el día que un plugin de terceros
// exista de verdad.
//
// 0.5.0 → 0.6.0 (2026-07-24, G3 plan / ADR 0037 "Plugin data-out v2"): el host
// pinta datos estructurados en vez de texto plano. TRES cambios:
//   1. `previewer` gana un export REQUERIDO, `render-styled` (devuelve
//      `styled-text` — líneas de spans con `role`/`fg` opcionales) hermano de
//      `render`. REQUERIDO porque los exports de una interfaz WIT son
//      todo-o-nada — un guest no puede implementar la mitad de `previewer`. Un
//      guest de solo-texto lo satisface trivialmente envolviendo su propio
//      `render` en un span por línea (sin rol ni color).
//   2. Dos worlds NUEVOS, `norte-decorator` y `norte-columns`, con el MISMO
//      patrón que `norte-provider` (world propio, interfaz propia, resueltos
//      por `category` del manifiesto, no plegados en `norte-plugin`).
//   3. `role: option<string>` en `span`/`decoration` NO se valida aquí — la
//      validación contra el conjunto cerrado de `norte_theme::Role` vive en el
//      HOST consumidor (`norte-core`), fuera de este paquete WIT (ADR 0037
//      decisión 1): un rol desconocido degrada a `none`, nunca rompe.
//
// AVISO (reafirma el AVISO de 0.4.0→0.5.0, ahora verificado DOS veces sobre
// este mismo paquete): el bump 0.5.0 → 0.6.0 es "aditivo" en el sentido de que
// ningún export/import EXISTENTE cambió de forma — pero la versión del
// paquete viaja en el nombre de CADA interfaz versionada
// (`norte:plugin/previewer@0.5.0` → `@0.6.0`, y también `host-log`/
// `host-config`), así que CUALQUIER artefacto `.wasm` compilado contra 0.5.0
// deja de instanciar contra el linker 0.6.0 — import no resuelto, el mismo
// fallo que en el bump anterior. T2 de este plan recompila TODOS los guests
// de `examples-wasm/` (vía symlink `wit -> ../../wit`, siempre desde el WIT
// actual) y re-ejecuta `just build-ftp-wasm` para
// `crates/norte-core/resources/ftp-provider.wasm` (embebido, ADR 0033) en el
// MISMO cambio que sube el paquete — nunca por separado.
package norte:plugin@0.6.0;

/// La puerta de host MÍNIMA (demuestra el gating host↔guest): un plugin puede
/// pedir al host que registre una línea de log (inocua, sin capability) y leer
/// un recurso que el host abrió bajo `fs-read=scoped` (gateado en el HOST).
interface host-log {
    log: func(message: string);

    /// Lee un recurso que el host preparó y referenció con `token`
    /// (fs-read=scoped). Si el plugin NO declaró fs-read, el host devuelve
    /// Err — el enforcement vive en el HOST, no en el guest (ADR 0022 D4).
    read-scoped: func(token: string) -> result<list<u8>, string>;
}

/// Settings VALIDADAS de `[config]` del plugin (P2 decisión 4): el host ya
/// resolvió los defaults del esquema del manifiesto con `config.toml`
/// superpuesto y validado (`norte-plugin-host::resolve_settings`) ANTES de
/// instanciar — el guest NUNCA ve el `config.toml` crudo ni decide sobre su
/// propia validez, solo lee el resultado. Codificación canónica de string
/// (mismo criterio en host y guest): `bool` → `"true"`/`"false"`; `int` →
/// decimal; `string`/`enum` → el texto crudo.
///
/// Puramente de LECTURA sobre un mapa en memoria del host: ninguna función
/// toca FS, red ni reloj (el sandbox de M4-P2 sigue intacto — esto no abre
/// una puerta nueva, solo expone datos que el host YA tenía resueltos antes de
/// instanciar).
interface host-config {
    /// El valor de `key`, o `none` si `key` no está declarada en `[config]`
    /// del manifiesto.
    get: func(key: string) -> option<string>;
    /// Todos los pares clave/valor resueltos (defaults + overrides).
    all: func() -> list<tuple<string, string>>;
}

/// Genera una previsualización de UN recurso que el HOST ya leyó y le pasa
/// (regla 9: el guest jamás toca el FS; recibe los bytes). Devuelve texto
/// plano listo para pintar, o un error legible.
interface previewer {
    record preview-input {
        /// Mimetype detectado por el host.
        mimetype: string,
        /// Contenido del recurso (el host lo leyó bajo fs-read=scoped).
        content: list<u8>,
    }
    render: func(input: preview-input) -> result<string, string>;

    /// Un fragmento de texto con estilo OPCIONAL (ADR 0037 decisión 2): el
    /// host pinta, el guest solo describe. `role` es un nombre semántico
    /// (validado por el HOST consumidor contra `norte_theme::Role` — este
    /// paquete WIT no conoce ese conjunto cerrado, un guest puede mandar
    /// cualquier string); `fg` es un RGB crudo de respaldo para spans sin rol
    /// (un highlighter con su propia paleta fija). Cuando un span trae AMBOS,
    /// el rol gana en el host (el tema del usuario manda sobre el color fijo
    /// del plugin) — decisión de pintado, no de este WIT.
    record span {
        text: string,
        role: option<string>,
        fg: option<tuple<u8, u8, u8>>,
    }

    /// Una línea = una secuencia ORDENADA de spans.
    type styled-line = list<span>;

    /// Un preview con estilo = una secuencia ORDENADA de líneas.
    type styled-text = list<styled-line>;

    /// Gemelo con estilo de `render` (ADR 0037 decisión 2): mismo `input`,
    /// devuelve líneas de spans en vez de una cadena plana. REQUERIDO — los
    /// exports de una interfaz WIT son todo-o-nada, así que un guest de solo
    /// texto lo implementa envolviendo su propio `render` en UN span por
    /// línea, sin `role` ni `fg` (ver el AVISO de cabecera de este paquete).
    /// El HOST aplica topes de anti-DoS al resultado (nº de líneas, spans por
    /// línea, bytes por span y bytes totales — ADR 0037 tabla de decisión 1)
    /// DESPUÉS de que esta función retorne; una violación se rechaza entera
    /// (fail-closed), nunca se trunca a medias.
    render-styled: func(input: preview-input) -> result<styled-text, string>;
}

/// Ejecuta un comando aportado por el plugin. `arg` es texto libre del
/// invocador; devuelve un mensaje para la barra de estado, o un error.
interface command {
    run: func(id: string, arg: string) -> result<string, string>;
}

/// Decora entradas visibles con un badge/rol tipo "git status" (ADR 0037
/// decisión 2, categoría de manifiesto `decorator`). Mundo propio
/// (`norte-decorator`), NO plegado en `norte-plugin` — mismo patrón que
/// `provider`.
interface decorator {
    /// `badge` = texto corto (el HOST lo acota a 8 chars TRAS enmascarar,
    /// ADR 0037 tabla de decisión 1; este WIT no impone esa longitud) o
    /// `none` = sin badge para esa entrada. `role` = nombre semántico
    /// (validado host-side, igual que `span::role`).
    record decoration {
        badge: option<string>,
        role: option<string>,
    }

    /// `entries` = los nombres/paths crudos (regla 1: bytes, jamás `string`)
    /// de la página VISIBLE actual, en el orden en que el host la lista. El
    /// resultado es POSICIONAL 1:1 con `entries` — el host jamás reordena ni
    /// dispersa (ADR 0037 tabla de decisión 1): `result[i]` decora
    /// `entries[i]`. Llamado en lote por página, nunca por entrada.
    decorate: func(entries: list<list<u8>>) -> list<decoration>;
}

/// Aporta valores computados para UNA columna del listado (ADR 0037 decisión
/// 2, categoría de manifiesto `columns`). Mundo propio (`norte-columns`).
interface columns {
    /// `id` identifica la columna (el manifiesto declara sus columnas
    /// aportadas; el host pasa el id de la que está pintando). `entries` =
    /// mismo contrato posicional que `decorator::decorate`. Cada celda es
    /// `option<string>`: `none` = "esta columna no aplica a esta entrada"
    /// (p. ej. "duración" sobre un fichero que no es media), distinguible de
    /// un valor real vacío — NUNCA se omite del vector, siempre 1:1 con
    /// `entries`.
    column-values: func(id: string, entries: list<list<u8>>) -> list<option<string>>;
}

/// El world que un plugin de norte implementa. Un plugin concreto exporta las
/// interfaces de su categoría; en M4-P2 el world exige AMBAS (`previewer` y
/// `command`) — un guest de una sola categoría implementa la otra como
/// no-soportada. Worlds por-categoría = deuda P2b.
world norte-plugin {
    import host-log;
    import host-config;
    export previewer;
    export command;
}

/// Interfaz `provider` (#30, ADR 0032): proyección SÍNCRONA del trait
/// `norte_vfs::Provider`. El streaming async se proyecta a llamadas ACOTADAS
/// (list paginado, read por rango) que el host reensambla. Paths y nombres
/// cruzan como BYTES CRUDOS (regla 1) — un path es su lista de segmentos, cada
/// segmento su lista de bytes; jamás un `string`. STAGE 2 = solo-lectura, sin
/// red: de-risk de la proyección.
interface provider {
    /// Tipo de una entrada del árbol.
    enum entry-kind { file, dir, symlink, other }

    /// Una entrada listada/consultada. `name` en bytes crudos (regla 1).
    record entry {
        name: list<u8>,
        kind: entry-kind,
        size: option<u64>,
    }

    /// Error del provider: proyección de `norte_proto::Error`. Se incluyen las
    /// variantes relevantes al camino de lectura para que la taxonomía NO se
    /// pierda (review): `cursor-expired` (la paginación lo necesita),
    /// `provider-unavailable` (transitorio remoto, stage 3), `loop` (symlinks).
    /// El flag `retryable` de `io`/`provider-unavailable` se difiere a stage 3
    /// (exigiría un `variant`, no un `enum`). `other` = variante conocida aún
    /// no mapeada — un `enum` WIT es CERRADO, no absorbe variantes futuras (a
    /// diferencia del `Unknown` de proto): añadir una es un cambio de wire.
    enum vfs-error {
        not-found,
        permission-denied,
        unsupported,
        invalid-path,
        io,
        corrupt,
        cursor-expired,
        provider-unavailable,
        %loop,
        conflict,
        no-space,
        other,
    }

    /// Capabilities proyectadas. Además del flag de solo-lectura, el guest
    /// declara HONESTAMENTE (fase 10a) la sensibilidad y preservación de caja
    /// (deciden qué casos de colisión de caja aplican en la suite contractual).
    /// Un flag que el guest no ponga se traduce a "capability ausente" en el
    /// adapter host. (Resume/APPEND no viaja: el adapter usa el `open_resumable`
    /// por defecto del trait, que NO reanuda — declararlo mentiría.)
    record caps {
        /// Solo-lectura: el adapter rechaza toda mutación.
        read-only: bool,
        /// El backend distingue `Caja` de `caja` (POSIX). Sin él, el adapter
        /// asume case-insensitive y la suite exige `CaseCollision`.
        case-sensitive: bool,
        /// El backend preserva la caja de los nombres al crearlos.
        case-preserving: bool,
    }

    /// Una página de entradas + el cursor OPACO de la siguiente (`none` = fin).
    /// El cursor es `list<u8>` (bytes opacos, como el token expirable de #27) —
    /// NO un índice: un provider remoto (continuación S3/FTP) no cabe en un u32.
    record page {
        entries: list<entry>,
        next-cursor: option<list<u8>>,
    }

    /// Capabilities del provider.
    capabilities: func() -> caps;

    /// Metadatos de una entrada (equiv. `Provider::stat`).
    stat: func(segments: list<list<u8>>) -> result<entry, vfs-error>;

    /// Lista PAGINADA (equiv. `Provider::list`): una página + el cursor opaco de
    /// la siguiente. El host reensambla el `EntryStream` llamando en bucle.
    /// (`list` es palabra reservada del WIT — de ahí `list-dir`.)
    list-dir: func(segments: list<list<u8>>, cursor: option<list<u8>>) -> result<page, vfs-error>;

    /// Lee un RANGO acotado (equiv. una porción del `ByteStream`): a lo sumo
    /// `len` bytes desde `offset`. Un chunk más corto que `len` = EOF.
    read: func(segments: list<list<u8>>, offset: u64, len: u64) -> result<list<u8>, vfs-error>;

    /// Configuración de un provider que ESTABLECE SU PROPIA conexión (#30 stage
    /// 3c, FTP). El HOST resuelve el hostname a IP, concede la capability `net`
    /// acotada a esa IP y llama a `configure` con el endpoint YA resuelto
    /// (`ip:puerto`) — el guest jamás resuelve DNS. Las credenciales cruzan a la
    /// memoria del guest (sandbox aislado): imprescindibles para el `login`;
    /// sobre FTP en claro (FTPS = deuda, aws-lc-rs no compila a wasm) ya viajan
    /// sin cifrar por el cable. `base` = raíz remota absoluta bajo la que vive
    /// todo. Un provider que no necesita conexión (mem) lo implementa como no-op.
    record provider-config {
        /// Endpoint YA resuelto por el host: `ip:puerto`.
        endpoint: string,
        /// Usuario de login (`anonymous` por convención guest).
        user: string,
        /// Password de login (viaja a memoria del guest para autenticar).
        password: string,
        /// Raíz remota absoluta (sin `..`, sin barra final significativa).
        base: string,
    }
    configure: func(cfg: provider-config) -> result<_, vfs-error>;

    /// Escritura TRANSACCIONAL (#30 stage 2b-write): proyección de
    /// `norte_vfs::ByteSink`. `open-writer` devuelve un `writer` (staging propio
    /// del guest; el path final NO existe hasta `commit`); `write` añade un
    /// chunk; `commit` publica atómicamente; `abort` descarta el staging. Soltar
    /// el `writer` sin commit debe limpiar (best-effort). El host reensambla el
    /// `ByteSink` sobre este recurso.
    resource writer {
        write: func(chunk: list<u8>) -> result<_, vfs-error>;
        commit: func() -> result<_, vfs-error>;
        abort: func() -> result<_, vfs-error>;
    }

    /// Abre un `writer` transaccional sobre el path (equiv. `Provider::write`).
    open-writer: func(segments: list<list<u8>>) -> result<writer, vfs-error>;

    /// Crea un directorio (equiv. `Provider::mkdir`).
    make-dir: func(segments: list<list<u8>>) -> result<_, vfs-error>;

    /// Borra una entrada (equiv. `Provider::remove`).
    remove: func(segments: list<list<u8>>) -> result<_, vfs-error>;

    /// Renombra/mueve (equiv. `Provider::rename`). (`from`/`to` son palabras
    /// reservadas del WIT — de ahí `src`/`dst`.)
    rename: func(src: list<list<u8>>, dst: list<list<u8>>) -> result<_, vfs-error>;
}

/// World de un plugin-provider (#30 stage 2): expone `provider` e importa
/// `host-log`. Separado de `norte-plugin` — un guest de provider no implementa
/// previewer/command.
world norte-provider {
    import host-log;
    import host-config;
    export provider;
}

/// World de un plugin-decorator (ADR 0037 decisión 2): expone `decorator` e
/// importa `host-log`/`host-config`. Separado de `norte-plugin` y de
/// `norte-provider` — un guest decorator no implementa previewer/command/
/// provider.
world norte-decorator {
    import host-log;
    import host-config;
    export decorator;
}

/// World de un plugin-columns (ADR 0037 decisión 2): expone `columns` e
/// importa `host-log`/`host-config`. Mismo patrón que `norte-decorator`.
world norte-columns {
    import host-log;
    import host-config;
    export columns;
}
