// Versioning: 0.1.0 → 0.2.0 added the `provider` interface + world
// `norte-provider` (#30 stage 2); 0.2.0 → 0.3.0 added the write path
// (writer resource + open-writer/make-dir/remove/rename); 0.3.0 → 0.4.0 (#30
// stage 3c) has TWO breaks for a `provider` guest, both covered by the
// single bump (0.4.0 was never published):
//   1. `configure(provider-config)`: a provider that ESTABLISHES ITS OWN
//      connection (FTP over wasi:sockets) receives endpoint+credentials+base. A
//      0.3.0 guest does not export `configure` → does not satisfy the 0.4.0
//      world.
//   2. `caps` went from 1 to 3 fields (`case-sensitive`, `case-preserving`): WIT
//      records have no optional fields or defaults, so the canonical ABI shape
//      of `capabilities() -> caps` changes — BREAKING on its own.
// It is safe because `provider` is pre-release and there are no published guests
// — the minor bump under 0.x encodes exactly "breakage allowed".
// WARNING (not entirely additive for the rest): previewer/command/host-log do
// not change TEXT, but the package's version travels in every versioned
// interface name (`norte:plugin/previewer@0.4.0`…). Under wasmtime's semver for
// 0.x, a third-party previewer/command guest compiled against `@0.3.0` does NOT
// instantiate on the 0.4.0 host. This is the shared package's known debt (ADR
// 0032): once `provider` stabilizes it splits into its own package via the
// `wit/deps/` layout (the tree's wit-parser, 0.239, does not support nested
// packages), and only then does the stable surface stop breaking alongside
// `provider`. protocol-guardian.
//
// 0.4.0 → 0.5.0 (P2 Task 3): adds the `host-config` interface (VALIDATED
// `[config]` settings, P2) imported by BOTH worlds. It is additive ONLY in
// the narrow sense of wasmtime LINKING: the host's `Linker` can offer one
// more function than a specific component imports without that, by itself,
// breaking anything (an extra import in the linker is never the problem;
// only an UNRESOLVED import is). But the SAME "WARNING" above applies just
// as strongly here, and it is not just theoretical: empirically VERIFIED for
// this bump — a `command-demo` `.wasm` compiled BEFORE this change
// (package 0.4.0, without `host-config`) was tested against the host ALREADY
// on 0.5.0 and instantiation FAILS:
//   "component imports instance `norte:plugin/host-log@0.4.0`, but a matching
//   implementation was not found in the linker"
// That is, the old guest asks for `host-log@0.4.0` (the versioned name it had
// baked in when compiled) and the 0.5.0 host's linker only offers
// `host-log@0.5.0` — it breaks on the IMPORT SIDE, not just the export side as
// the original analysis warned. This confirms the shared package's debt
// (ADR 0032): ANY bump of this `package` invalidates ALL already-compiled
// `.wasm` artifacts, additive or not in their textual content. Within this
// repo it does not matter (the `examples-wasm/` guests are always recompiled
// from the current WIT, via symlink) — it would matter the day a real
// third-party plugin exists.
//
// 0.5.0 → 0.6.0 (2026-07-24, G3 plan / ADR 0037 "Plugin data-out v2"): the host
// paints structured data instead of plain text. THREE changes:
//   1. `previewer` gains a REQUIRED export, `render-styled` (returns
//      `styled-text` — lines of spans with optional `role`/`fg`), a sibling of
//      `render`. REQUIRED because a WIT interface's exports are
//      all-or-nothing — a guest cannot implement half of `previewer`. A
//      text-only guest satisfies it trivially by wrapping its own `render` in
//      one span per line (no role or color).
//   2. Two NEW worlds, `norte-decorator` and `norte-columns`, with the SAME
//      pattern as `norte-provider` (its own world, its own interface, resolved
//      by the manifest's `category`, not folded into `norte-plugin`).
//   3. `role: option<string>` in `span`/`decoration` is NOT validated here — the
//      validation against `norte_theme::Role`'s closed set lives in the
//      consuming HOST (`norte-core`), outside this WIT package (ADR 0037
//      decision 1): an unknown role degrades to `none`, it never breaks.
//
// WARNING (reaffirms the 0.4.0→0.5.0 WARNING, now verified TWICE on
// this same package): the 0.5.0 → 0.6.0 bump is "additive" in the sense that
// no EXISTING export/import changed shape — but the package's version
// travels in the name of EVERY versioned interface
// (`norte:plugin/previewer@0.5.0` → `@0.6.0`, and also `host-log`/
// `host-config`), so ANY `.wasm` artifact compiled against 0.5.0
// stops instantiating against the 0.6.0 linker — unresolved import, the same
// failure as the previous bump. T2 of this plan recompiles ALL the
// `examples-wasm/` guests (via the `wit -> ../../wit` symlink, always from the
// current WIT) and re-runs `just build-ftp-wasm` for
// `crates/norte-core/resources/ftp-provider.wasm` (embedded, ADR 0033) in the
// SAME change that bumps the package — never separately.
//
// 0.6.0 → 0.7.0 (2026-08-08, ADR 0041 decision 4): THE PACKAGE SPLITS IN THREE.
// `host-log`/`host-config` move to `norte:host@0.1.0`; `provider` and its world
// move to `norte:provider@0.1.0`; previewer/command/decorator/columns and
// their three worlds stay here.
//
// The reason is the WARNING above, repeated twice and never resolved: the
// package's version travels inside the name of EVERY interface, so a
// change in `provider` — and there are going to be many, because ADR 0041
// decision 3 says the gaps get filled in as a real plugin asks for them —
// would stop ALL third-party previewers from instantiating. Split, a
// `norte:provider` bump does not touch `norte:plugin/previewer`'s name.
//
// This split is, itself, the last break for every guest at once:
// host-log/host-config's names change package. The `examples-wasm/` guests
// are recompiled in this same change (the `wit` symlink), same as
// `crates/norte-core/resources/ftp-provider.wasm` via `just build-ftp-wasm`.
// 0.7.0 → 0.8.0 (2026-08-16, roadmap item 6 / ADR 0057): `columns::column-values`
// gains a `location: option<string>` parameter — the opaque token an
// APPROVED guest uses to read under the directory being listed (new package
// `norte:location@0.1.0`, imported by the `norte-columns` world).
//
// It is a DOUBLE break, on purpose: it changes an existing export's
// signature — WIT records and functions have no optional parameters —
// and, by the WARNING above, verified three times already, the package
// bump equally invalidates every `.wasm` compiled against 0.7.0 on the
// IMPORT side. It is worth it because without a location, a columns plugin
// cannot exist that says something about the file and not just its name: the
// first one wanted, git status, needs to read `.git/index`.
//
// The token is opaque and single-use in a logical sense (minted by the host per
// request): the guest never learns the path, which is what makes this not a
// hole in rule 9 but a capability with its own permission.
//
// 2026-09-03 (demo D2, ADR 0094): the `norte-columns` world imports
// `norte:location@0.2.0` (`read-prefix`). This package stays at 0.8.0: it does
// not change any of ITS interfaces — `norte:plugin/previewer@0.8.0` is still
// called the same — so a previewer compiled yesterday still loads. A
// columns guest compiled against 0.1.0 imports a name that no longer exists
// and the catalog lists it as mismatched, with both versions.
//
// 0.8.0 → 0.9.0 (2026-09-03, demo D4 / ADR 0037 amendment): `span` gains `bg`
// and `preview-input` gains `columns`. The image previewer needs them: half
// blocks with two pixels per cell, and the width to shrink to. WIT records
// have no optional fields, so it is a BREAK for every previewer and
// command compiled against 0.8.0 (syntect, the template, markdown, the demos):
// they are recompiled here, and the outside ones are listed as mismatched (ADR 0094).
//
// 0.9.0 → 0.10.0 (2026-09-10, ADR 0105): `decorator::decorate` receives
// `list<entry>` — name AND class — instead of `list<list<u8>>`. The icon
// column needs it: a name does not say whether it is a folder. It changes the
// signature of a `decorator` interface export, so it is a BREAK for every decorator
// compiled against 0.9.0 (file-icons, the demo) and, because of the versioned
// name, for every previewer/command/provider of the package: the seven in this
// tree are recompiled with `just plugins force` and re-approved. The outside
// ones are listed as mismatched with both versions (ADR 0094).
package norte:plugin@0.10.0;

/// Generates a preview of ONE resource the HOST already read and hands
/// over (rule 9: the guest never touches the FS; it receives the bytes).
/// Returns plain text ready to paint, or a readable error.
interface previewer {
    record preview-input {
        /// Mimetype detected by the host.
        mimetype: string,
        /// Resource content (the host read it under fs-read=scoped).
        content: list<u8>,
        /// Width of the viewer about to paint, in cells (0.9.0, demo D4), or
        /// `none` if the requester has no viewer (the CLI). A HINT: an
        /// image previewer uses it to decide how many cells to shrink to;
        /// a text one ignores it and the viewer trims as always.
        columns: option<u32>,
    }
    render: func(input: preview-input) -> result<string, string>;

    /// A fragment of text with an OPTIONAL style (ADR 0037 decision 2): the
    /// host paints, the guest only describes. `role` is a semantic name
    /// (validated by the consuming HOST against `norte_theme::Role::REQUESTABLE`
    /// — this WIT package does not know that closed set, a guest can
    /// send any string). The requestable roles are the ones of MEANING
    /// (`error`, `warning`, `info`, `title`, `match`, `regular`,
    /// `hostile-badge`, `badge`, `muted`); the window's CHROME and STATE
    /// (`selection`, `status-bar`, `mark`…) are not, and degrade to `none`
    /// just like an unknown name. `fg` is a raw RGB fallback (a
    /// highlighter with its own fixed palette). When a span carries BOTH,
    /// the role wins on the host (the user's theme overrides the plugin's
    /// fixed color) — a painting decision, not this WIT's.
    record span {
        text: string,
        role: option<string>,
        fg: option<tuple<u8, u8, u8>>,
        /// BACKGROUND color (0.9.0, demo D4): an image previewer paints each
        /// cell as a `▀` half block with the top pixel in `fg` and the
        /// bottom one in `bg`. No role overrides it: the theme's roles are
        /// chrome and none of them describe a fragment's background.
        bg: option<tuple<u8, u8, u8>>,
    }

    /// A line = an ORDERED sequence of spans.
    type styled-line = list<span>;

    /// A styled preview = an ORDERED sequence of lines.
    type styled-text = list<styled-line>;

    /// Styled twin of `render` (ADR 0037 decision 2): same `input`,
    /// returns lines of spans instead of a plain string. REQUIRED — a WIT
    /// interface's exports are all-or-nothing, so a text-only guest
    /// implements it by wrapping its own `render` in ONE span per
    /// line, with no `role` or `fg` (see this package's header WARNING).
    /// The HOST applies anti-DoS caps to the result (line count, spans per
    /// line, bytes per span and total bytes — ADR 0037 decision table 1)
    /// AFTER this function returns; a violation is rejected whole
    /// (fail-closed), never truncated halfway.
    render-styled: func(input: preview-input) -> result<styled-text, string>;
}

/// Runs a command the plugin contributes. `arg` is free text from the
/// invoker; returns a message for the status bar, or an error.
interface command {
    run: func(id: string, arg: string) -> result<string, string>;
}

/// Decorates visible entries with a "git status"-like badge/role (ADR 0037
/// decision 2, manifest category `decorator`). Its own world
/// (`norte-decorator`), NOT folded into `norte-plugin` — same pattern as
/// `provider`.
interface decorator {
    /// What class of entry it is, as the host listed it (0.10.0, ADR
    /// 0105). An ICON decorator needs it: a name does not say whether it
    /// is a folder, and `/bcds` with no icon next to `main.rs` with its own
    /// was the complaint. `other` = device, socket, or a future protocol
    /// class: the guest treats it as a file.
    enum entry-kind {
        file,
        dir,
        symlink,
        other,
    }

    /// A page entry: its raw name (rule 1: bytes, never
    /// `string`) and its class.
    record entry {
        name: list<u8>,
        kind: entry-kind,
    }

    /// `badge` = short text (the HOST caps it at 8 chars AFTER masking,
    /// ADR 0037 decision table 1; this WIT does not impose that length) or
    /// `none` = no badge for that entry. `role` = semantic name
    /// (validated host-side against `Role::REQUESTABLE`, same as
    /// `span::role`). Which SLOT of the
    /// row it is painted in — icon to the left of the name, or badge to the
    /// right — is decided by the manifest (`[[contributions.decorator]] slot`),
    /// not the guest: it is a screen decision, not a data one.
    record decoration {
        badge: option<string>,
        role: option<string>,
    }

    /// `entries` = the entries of the current VISIBLE page, in the order the
    /// host lists it. The result is POSITIONAL 1:1 with `entries` —
    /// the host never reorders nor sparses it (ADR 0037 decision table 1):
    /// `result[i]` decorates `entries[i]`. Called in a batch per page, never
    /// per entry.
    decorate: func(entries: list<entry>) -> list<decoration>;
}

/// Contributes computed values for ONE listing column (ADR 0037 decision
/// 2, manifest category `columns`). Its own world (`norte-columns`).
interface columns {
    /// `id` identifies the column (the manifest declares its contributed
    /// columns; the host passes the id of the one it is painting). `entries` =
    /// same positional contract as `decorator::decorate`. Each cell is
    /// `option<string>`: `none` = "this column does not apply to this entry"
    /// (e.g. "duration" over a file that is not media), distinguishable from
    /// an actual empty value — NEVER omitted from the vector, always 1:1 with
    /// `entries`.
    ///
    /// `location` (0.8.0) is the OPAQUE token of the location being
    /// listed, for a guest approved for the `location` capability;
    /// `none` = it was not approved, or the host could not open the directory. A
    /// guest that receives `none` still has to keep answering — with `none`
    /// cells — instead of failing: the column stays empty, not the panel.
    /// The location the host opened for this call: the opaque token used
    /// to read it, and the `prefix` — relative to that root — of the directory
    /// being listed.
    ///
    /// Both are needed because the root does NOT have to be the visible
    /// directory: a plugin can declare a project-root `marker` in its
    /// manifest (`.git`, for example) and then the host opens the
    /// nearest ANCESTOR that contains it. Without `prefix`, the guest would
    /// not know which part of that root the user is looking at; with it, it
    /// neither needs to — nor can — go up on its own.
    record location-ref {
        token: string,
        prefix: list<u8>,
    }

    column-values: func(id: string, location: option<location-ref>,
                        entries: list<list<u8>>) -> list<option<string>>;
}

/// The world a norte plugin implements. A specific plugin exports the
/// interfaces of its category; in M4-P2 the world requires BOTH (`previewer`
/// and `command`) — a guest of a single category implements the other as
/// not-supported. Per-category worlds = P2b debt.
world norte-plugin {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    export previewer;
    export command;
}

/// World of a plugin-decorator (ADR 0037 decision 2): exposes `decorator` and
/// imports `host-log`/`host-config`. Separate from `norte-plugin` and
/// `norte-provider` — a decorator guest does not implement previewer/command/
/// provider.
world norte-decorator {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    export decorator;
}

/// World of a plugin-columns (ADR 0037 decision 2): exposes `columns` and
/// imports `host-log`/`host-config`. Same pattern as `norte-decorator`.
world norte-columns {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    // ALWAYS imported: the host's linker offers the interface to every columns
    // guest, and what decides whether it SERVES anything is the manifest's
    // approved capability (a `none` token, or an unknown-token error). An
    // extra import in the linker never breaks anything; an unresolved one
    // does.
    import norte:location/location@0.2.0;
    export columns;
}
