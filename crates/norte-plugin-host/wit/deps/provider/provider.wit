// The provider interface, in its own package (ADR 0041 decision 4).
//
// It lives apart from `norte:plugin` because it is the one that is going to
// move THE MOST: ADR 0041 decision 3 says its gaps — server-side copy,
// trash, attributes, resume, cancellation — get filled in when a real plugin
// asks for them, and each one is a bump. While it shared a package with
// `previewer`, each of those bumps stopped every already-compiled previewer
// from instantiating.
//
// It starts at 0.1.0 and does not inherit the 0.6.0 of the package it came
// from: it is a new package, and its earlier history is in
// `norte-plugin.wit`'s header.
package norte:provider@0.1.0;

/// `provider` interface (#30, ADR 0032): SYNCHRONOUS projection of the
/// `norte_vfs::Provider` trait. Async streaming is projected to BOUNDED
/// calls (paginated list, ranged read) that the host reassembles. Paths and
/// names cross as RAW BYTES (rule 1) — a path is its list of segments, each
/// segment its list of bytes; never a `string`. STAGE 2 = read-only, no
/// network: de-risking the projection.
interface provider {
    /// Type of a tree entry.
    enum entry-kind { file, dir, symlink, other }

    /// A listed/queried entry. `name` in raw bytes (rule 1).
    record entry {
        name: list<u8>,
        kind: entry-kind,
        size: option<u64>,
    }

    /// Provider error: projection of `norte_proto::Error`. The variants
    /// relevant to the read path are included so the taxonomy is NOT lost
    /// (review): `cursor-expired` (pagination needs it),
    /// `provider-unavailable` (transient remote, stage 3), `loop` (symlinks).
    /// The `retryable` flag of `io`/`provider-unavailable` is deferred to
    /// stage 3 (it would require a `variant`, not an `enum`). `other` = a
    /// known variant not yet mapped — a WIT `enum` is CLOSED, it does not
    /// absorb future variants (unlike proto's `Unknown`): adding one is a
    /// wire change.
    enum vfs-error {
        not-found,
        permission-denied,
        unsupported,
        invalid-path,
        io,
        corrupt,
        cursor-expired,
        provider-unavailable,
        %loop,
        conflict,
        no-space,
        other,
    }

    /// Projected capabilities. Besides the read-only flag, the guest
    /// HONESTLY declares (phase 10a) case sensitivity and preservation
    /// (they decide which case-collision cases apply in the contract
    /// suite). A flag the guest does not set translates to "capability
    /// absent" in the host adapter. (Resume/APPEND does not travel: the
    /// adapter uses the trait's default `open_resumable`, which does NOT
    /// resume — declaring it would be a lie.)
    record caps {
        /// Read-only: the adapter rejects every mutation.
        read-only: bool,
        /// The backend distinguishes `Case` from `case` (POSIX). Without it,
        /// the adapter assumes case-insensitive and the suite requires
        /// `CaseCollision`.
        case-sensitive: bool,
        /// The backend preserves names' case when creating them.
        case-preserving: bool,
    }

    /// A page of entries + the next OPAQUE cursor (`none` = end).
    /// The cursor is `list<u8>` (opaque bytes, like #27's expirable token) —
    /// NOT an index: a remote provider (S3/FTP continuation) does not fit in a u32.
    record page {
        entries: list<entry>,
        next-cursor: option<list<u8>>,
    }

    /// Provider capabilities.
    capabilities: func() -> caps;

    /// Metadata of an entry (equiv. `Provider::stat`).
    stat: func(segments: list<list<u8>>) -> result<entry, vfs-error>;

    /// PAGINATED listing (equiv. `Provider::list`): a page + the next opaque
    /// cursor. The host reassembles the `EntryStream` by calling in a loop.
    /// (`list` is a WIT reserved word — hence `list-dir`.)
    list-dir: func(segments: list<list<u8>>, cursor: option<list<u8>>) -> result<page, vfs-error>;

    /// Reads a bounded RANGE (equiv. a slice of the `ByteStream`): at most
    /// `len` bytes from `offset`. A chunk shorter than `len` = EOF.
    read: func(segments: list<list<u8>>, offset: u64, len: u64) -> result<list<u8>, vfs-error>;

    /// Configuration for a provider that ESTABLISHES ITS OWN connection (#30
    /// stage 3c, FTP). The HOST resolves the hostname to an IP, grants the
    /// `net` capability scoped to that IP and calls `configure` with the
    /// endpoint ALREADY resolved (`ip:port`) — the guest never resolves
    /// DNS. Credentials cross into the guest's memory (isolated sandbox):
    /// essential for `login`; over plain FTP (FTPS = debt, aws-lc-rs does
    /// not compile to wasm) they already travel unencrypted over the wire.
    /// `base` = absolute remote root everything lives under. A provider
    /// that needs no connection (mem) implements it as a no-op.
    record provider-config {
        /// Endpoint ALREADY resolved by the host: `ip:port`.
        endpoint: string,
        /// Login user (`anonymous` by guest convention).
        user: string,
        /// Login password (travels to guest memory to authenticate).
        password: string,
        /// Absolute remote root (no `..`, no significant trailing slash).
        base: string,
    }
    configure: func(cfg: provider-config) -> result<_, vfs-error>;

    /// TRANSACTIONAL write (#30 stage 2b-write): projection of
    /// `norte_vfs::ByteSink`. `open-writer` returns a `writer` (the guest's
    /// own staging; the final path does NOT exist until `commit`); `write`
    /// appends a chunk; `commit` publishes atomically; `abort` discards the
    /// staging. Dropping the `writer` without a commit must clean up
    /// (best-effort). The host reassembles the `ByteSink` over this
    /// resource.
    resource writer {
        write: func(chunk: list<u8>) -> result<_, vfs-error>;
        commit: func() -> result<_, vfs-error>;
        abort: func() -> result<_, vfs-error>;
    }

    /// Opens a transactional `writer` over the path (equiv. `Provider::write`).
    open-writer: func(segments: list<list<u8>>) -> result<writer, vfs-error>;

    /// Creates a directory (equiv. `Provider::mkdir`).
    make-dir: func(segments: list<list<u8>>) -> result<_, vfs-error>;

    /// Deletes an entry (equiv. `Provider::remove`).
    remove: func(segments: list<list<u8>>) -> result<_, vfs-error>;

    /// Renames/moves (equiv. `Provider::rename`). (`from`/`to` are WIT
    /// reserved words — hence `src`/`dst`.)
    rename: func(src: list<list<u8>>, dst: list<list<u8>>) -> result<_, vfs-error>;
}

/// World of a plugin-provider (#30 stage 2): exposes `provider` and imports
/// `host-log`. Separate from `norte-plugin` — a provider guest does not
/// implement previewer/command.
world norte-provider {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    export provider;
}
