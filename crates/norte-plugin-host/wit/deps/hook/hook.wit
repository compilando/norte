// `norte:hook` (H1, ADR 0100): un plugin OBSERVA las mutaciones que el
// journal ya registró. Nada de lo que devuelve cambia un fichero: el único
// efecto es `notify`, una frase para el humano que el host enmascara, acota y
// atribuye al plugin. Un hook que atrapa, tarda o se pasa de presupuesto no
// hace fallar ninguna operación: ya ocurrió cuando el hook la ve.
//
// Por qué solo `after-*`: un hook que pudiera vetar sería una segunda puerta
// de policy, con motivos fuera del vocabulario que el humano aprueba y con un
// fallo (trap, timeout) que habría que resolver como «sí» o como «no» — las
// dos respuestas mal para algún plugin. Lo que decide si una mutación ocurre
// es el policy engine, y sus veredictos son lo que la cadena de auditoría
// atestigua. Ver ADR 0100.
//
// Paquete propio, como `norte:renamer` (ADR 0041 decisión 4, ADR 0094): la
// versión viaja en el nombre de cada interfaz y subir esto no puede invalidar
// a los previewers de terceros. Empieza en 0.1.0 y sube por su cuenta.
//
// 0.1.0 → 0.2.0 (ADR 0101): `effect` gana `write-sidecar`, y `on-events`
// recibe `dropped`. Un guest compilado contra 0.1.0 se lista como desfasado
// hasta recompilar (ADR 0094). 0.1.0 no llegó a ningún tercero.
package norte:hook@0.2.0;

/// Un observador de mutaciones. Recibe, en cada llamada, las entradas del
/// journal que llegaron desde la anterior y que casan con los eventos de su
/// manifiesto (`on = "after-renamed"`…), y devuelve los efectos que quiere.
interface hook {
    /// La operación registrada: el mismo vocabulario que la columna `op` del
    /// journal. Cerrado; un plugin que no conozca uno lo ignora.
    enum op { created, removed, trashed, renamed, mode-changed }

    /// Quién la causó. Un agente NO viene con su id de sesión: un hook sabe
    /// que fue un agente, no cuál.
    enum actor-kind { user, agent, plugin }

    /// La ubicación que el host abrió para el DIRECTORIO PADRE de `path`,
    /// para un guest al que se le aprobó la capacidad `location`: el token
    /// opaco con el que se lee (`norte:location`) y el `prefix` relativo a la
    /// raíz abierta. `none` = no se le aprobó, o no se pudo abrir (una ruta
    /// remota, una raíz protegida). Un guest que reciba `none` sigue
    /// contestando con lo que el evento ya dice.
    record location-ref {
        token: string,
        prefix: list<u8>,
    }

    /// Una entrada del journal, ya durable.
    record event {
        /// El `seq` de la entrada: monótono, sirve para deduplicar.
        seq: u64,
        /// Milisegundos UTC del registro.
        ts-ms: s64,
        op: op,
        actor: actor-kind,
        /// El nodo afectado, en la FORMA DE CABLE del `VPath` (`file:///a/b`,
        /// con percent-encoding): es texto por construcción, y lo que un
        /// `renamed` deja aquí es el nombre NUEVO.
        path: string,
        /// El otro extremo de un `renamed` (el nombre que HABÍA), en la misma
        /// forma. Para `mode-changed` lleva el modo nuevo en decimal.
        path-to: option<string>,
        /// El último segmento de `path`, en BYTES crudos (regla 1): lo que se
        /// le pasa a `stat` bajo `location` para mirar el resultado.
        name: list<u8>,
        /// El lote al que pertenece la entrada (`fs.rename_batch`, un
        /// `set_mode` recursivo), si formó parte de uno. Los eventos de un
        /// mismo lote llegan juntos cuando caben en una llamada.
        batch: option<u64>,
        location: option<location-ref>,
    }

    /// Qué hacer si el sidecar ya existe. `replace` no sobrescribe en sitio:
    /// el host lleva el fichero que había a la papelera lógica y crea el
    /// nuevo, así que el contenido anterior tiene vuelta atrás.
    enum on-exists { refuse, replace }

    /// Un fichero JUNTO a lo que cambió (ADR 0101): `name` es uno de los
    /// nombres que el manifiesto declara en `fs-write = { sidecar = [...] }`
    /// —el host rechaza cualquier otro— y se escribe en el directorio PADRE
    /// del evento `seq` de esta misma llamada. El host lo escribe como actor
    /// `plugin`, por el policy engine y por el journal; el guest nunca ve la
    /// ruta. `content` como mucho 64 KiB.
    record sidecar {
        seq: u64,
        name: list<u8>,
        content: list<u8>,
        if-exists: on-exists,
    }

    /// Lo que un hook puede pedir: una frase para el humano, que el host
    /// enmascara (controles, bidi) y acota antes de enseñarla, atribuida al
    /// plugin; o un sidecar. Un efecto que la policy del humano deniega no
    /// es un fallo del hook: se le dice al humano una vez y se sigue.
    variant effect {
        notify(string),
        write-sidecar(sidecar),
    }

    /// Los eventos desde la última llamada, en orden de `seq`. `dropped` es
    /// cuántos eventos se descartaron por cola llena desde la llamada
    /// anterior: si no es cero, lo que hay en `events` NO es todo lo que
    /// pasó, y una frase que cuente debe decirlo. Un `err` es una frase para
    /// el registro del daemon; tres seguidos —o tres traps, o tres llamadas
    /// fuera de presupuesto— apagan los hooks de este plugin hasta que se
    /// desactive y se reactive.
    on-events: func(events: list<event>, dropped: u64) -> result<list<effect>, string>;
}

/// El world de un plugin `hook`: importa lo mismo que `norte-renamer` y
/// exporta `hook`.
world norte-hook {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    // Importado SIEMPRE, como en `norte-columns`: el linker lo ofrece a todo
    // guest y lo que decide si SIRVE algo es la capacidad aprobada.
    import norte:location/location@0.2.0;
    export hook;
}
