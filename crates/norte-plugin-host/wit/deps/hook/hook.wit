// `norte:hook` (H1, ADR 0100): a plugin OBSERVES the mutations the journal
// already recorded. Nothing it returns changes a file: the only effect is
// `notify`, a sentence for the human that the host masks, caps and
// attributes to the plugin. A hook that traps, is slow or exceeds its
// budget does not fail any operation: it already happened by the time the
// hook sees it.
//
// Why only `after-*`: a hook that could veto would be a second policy
// gate, with reasons outside the vocabulary the human approves and with a
// failure (trap, timeout) that would have to be resolved as "yes" or as
// "no" — both answers wrong for some plugin. What decides whether a
// mutation happens is the policy engine, and its verdicts are what the
// audit chain attests. See ADR 0100.
//
// Its own package, like `norte:renamer` (ADR 0041 decision 4, ADR 0094):
// the version travels in the name of each interface and bumping this
// must not invalidate third-party previewers. It starts at 0.1.0 and
// bumps on its own.
//
// 0.1.0 → 0.2.0 (ADR 0101): `effect` gains `write-sidecar`. A guest
// compiled against 0.1.0 is listed as mismatched until recompiled (ADR
// 0094). 0.1.0 never reached any third party.
package norte:hook@0.2.0;

/// An observer of mutations. Receives, on each call, the journal entries
/// that arrived since the previous one and that match the events in its
/// manifest (`on = "after-renamed"`…), and returns the effects it wants.
interface hook {
    /// The recorded operation: the same vocabulary as the journal's `op`
    /// column. Closed; a plugin that does not know one ignores it.
    enum op { created, removed, trashed, renamed, mode-changed }

    /// Who caused it. An agent does NOT come with its session id: a hook
    /// knows it was an agent, not which one.
    enum actor-kind { user, agent, plugin }

    /// The location the host opened for `path`'s PARENT DIRECTORY, for a
    /// guest approved for the `location` capability: the opaque token
    /// used to read it (`norte:location`) and the `prefix` relative to
    /// the opened root. `none` = it was not approved, or it could not be
    /// opened (a remote path, a protected root). A guest that receives
    /// `none` keeps answering with what the event already says.
    record location-ref {
        token: string,
        prefix: list<u8>,
    }

    /// A journal entry, already durable.
    record event {
        /// The entry's `seq`: monotonic, useful for deduplication.
        seq: u64,
        /// UTC milliseconds of the record.
        ts-ms: s64,
        op: op,
        actor: actor-kind,
        /// The affected node, in the `VPath`'s WIRE FORM (`file:///a/b`,
        /// with percent-encoding): it is text by construction, and what a
        /// `renamed` leaves here is the NEW name.
        path: string,
        /// The other end of a `renamed` (the name it HAD), in the same
        /// form. For `mode-changed` it carries the new mode in decimal.
        path-to: option<string>,
        /// `path`'s last segment, in raw BYTES (rule 1): what gets passed
        /// to `stat` under `location` to look at the result.
        name: list<u8>,
        /// The batch the entry belongs to (`fs.rename_batch`, a recursive
        /// `set_mode`), if it was part of one. Events from the same batch
        /// arrive together when they fit in one call.
        batch: option<u64>,
        location: option<location-ref>,
    }

    /// What to do if the sidecar already exists. `replace` does not
    /// overwrite in place: the host sends the previous file to the
    /// logical trash and creates the new one, so the earlier content has
    /// an undo path.
    enum on-exists { refuse, replace }

    /// A file ALONGSIDE what changed (ADR 0101): `name` is one of the
    /// names the manifest declares in `fs-write = { sidecar = [...] }`
    /// — the host rejects any other — and it is written in the PARENT
    /// directory of this same call's `seq` event. The host writes it as
    /// the `plugin` actor, through the policy engine and the journal; the
    /// guest never sees the path. `content` at most 64 KiB, and at most
    /// four sidecars per call: exceeding either rejects the WHOLE call
    /// and counts as a failure for the fuse. A name not in the manifest,
    /// or a `seq` not from this call, count the same; a directory the
    /// host does not write to — remote, protected, home, the root — is
    /// silently dropped and does not count. The rows a plugin writes
    /// NEVER come back as events to any hook: a sidecar does not trigger
    /// hooks.
    record sidecar {
        seq: u64,
        name: list<u8>,
        content: list<u8>,
        if-exists: on-exists,
    }

    /// What a hook can ask for: a sentence for the human, which the host
    /// masks (control characters, bidi) and caps before showing it,
    /// attributed to the plugin; or a sidecar. An effect the human's
    /// policy denies is not a hook failure: the human is told once and
    /// things move on.
    variant effect {
        notify(string),
        write-sidecar(sidecar),
    }

    /// The events since the last call, in `seq` order. `dropped` is how
    /// many events were dropped for a full queue since the previous
    /// call: if it is not zero, what is in `events` is NOT everything
    /// that happened, and a sentence that counts must say so. An `err` is
    /// a sentence for the daemon's log; three in a row — or three traps,
    /// or three over-budget calls — turn off this plugin's hooks until it
    /// is disabled and re-enabled.
    on-events: func(events: list<event>, dropped: u64) -> result<list<effect>, string>;
}

/// The world of a `hook` plugin: imports the same as `norte-renamer` and
/// exports `hook`.
world norte-hook {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    // ALWAYS imported, as in `norte-columns`: the linker offers it to
    // every guest and what decides whether it SERVES anything is the
    // approved capability.
    import norte:location/location@0.2.0;
    export hook;
}
