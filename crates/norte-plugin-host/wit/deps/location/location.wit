// `norte:location` es la capacidad de LEER BAJO el directorio que el host está
// listando, sin que el guest sepa cuál es. El host acuña un `token` opaco por
// petición; el guest lo devuelve en cada llamada y jamás recibe una ruta.
//
// Por qué un paquete propio y no una interfaz más de `norte:plugin` (ADR 0041
// decisión 4): la versión del paquete viaja dentro del nombre de CADA interfaz,
// así que un cambio aquí no puede permitirse invalidar a los previewers de
// terceros. Empieza en 0.1.0 y sube por su cuenta.
//
// 0.1.0 → 0.2.0 (2026-09-03, demo D2 / ADR 0094): `read-prefix`. `read` lee
// el fichero ENTERO y lo cobra entero contra el presupuesto de la página; una
// columna que solo necesita la cabecera de un mp3 o de un png agotaba los
// 64 MiB de la sesión en una docena de filas, y un vídeo nunca daba celda.
// Primer bump del WIT desde que ADR 0094 dijo qué pasa cuando hay uno: los
// guests compilados contra 0.1.0 (git-status) se listan como desfasados hasta
// recompilar. `norte:plugin` NO sube: ninguna interfaz suya cambia de nombre,
// solo el import del world `norte-columns`, y eso no toca a los previewers.
package norte:location@0.2.0;

/// Lectura ACOTADA bajo una ubicación que el host abrió y confinó
/// (`openat2(RESOLVE_BENEATH)` en `norte-vfs-local`). Todo lo que aquí falla
/// devuelve un `string` legible: el guest no distingue causas del sistema
/// operativo, y no tiene por qué.
interface location {
    /// Qué es una entrada. Grueso a propósito.
    enum entry-kind { file, dir, symlink, other }

    /// Lo que `stat` devuelve: exactamente los campos que el índice de git
    /// guarda. Comparar solo `mtime` es cómo se pierde un cambio hecho dentro
    /// del mismo segundo, así que van también `ctime`, `ino` y `dev`.
    record meta {
        kind: entry-kind,
        size: u64,
        mtime-sec: s64,
        mtime-nsec: u32,
        ctime-sec: s64,
        ctime-nsec: u32,
        ino: u64,
        dev: u64,
        mode: u32,
    }

    /// Una entrada de un listado. `name` va en BYTES: la regla dura 1 no deja
    /// de aplicar porque la ruta cruce una ABI.
    record dirent {
        name: list<u8>,
        kind: entry-kind,
    }

    /// Lee un fichero bajo la ubicación. `rel` es relativo y en bytes; un `..`
    /// que se salga, una ruta absoluta o un symlink final son un error, no un
    /// contenido.
    read: func(token: string, rel: list<u8>) -> result<list<u8>, string>;

    /// Como `read`, pero como mucho los primeros `max` bytes: lo que una
    /// cabecera necesita. El host lee y COBRA solo lo que devuelve, así que
    /// una columna sobre cien vídeos cuesta cien cabeceras y no cien vídeos.
    /// Un fichero más corto que `max` llega entero; el guest no distingue
    /// «cabía» de «se cortó» salvo por `stat`, y no tiene por qué.
    read-prefix: func(token: string, rel: list<u8>, max: u64) -> result<list<u8>, string>;

    /// `lstat` de una entrada bajo la ubicación (el symlink NO se sigue).
    stat: func(token: string, rel: list<u8>) -> result<meta, string>;

    /// Lista un directorio bajo la ubicación. `.` y `..` no salen.
    ///
    /// Se llama `list-dir` y no `list` porque `list` es palabra reservada de
    /// WIT (es el constructor de tipo `list<T>`), y el parser corta ahí.
    list-dir: func(token: string, rel: list<u8>) -> result<list<dirent>, string>;
}
