// `norte:location` is the capability to READ UNDER the directory the host is
// listing, without the guest knowing which one it is. The host mints an
// opaque `token` per request; the guest returns it on every call and never
// receives a path.
//
// Why its own package and not one more interface of `norte:plugin` (ADR 0041
// decision 4): a package's version travels inside the name of EVERY interface,
// so a change here cannot be allowed to invalidate third-party previewers.
// It starts at 0.1.0 and bumps on its own.
//
// 0.1.0 → 0.2.0 (2026-09-03, demo D2 / ADR 0094): `read-prefix`. `read` reads
// the WHOLE file and charges it whole against the page's budget; a
// column that only needs an mp3's or a png's header would exhaust the
// session's 64 MiB in a dozen rows, and a video never got a cell.
// First WIT bump since ADR 0094 said what happens when there is one: guests
// compiled against 0.1.0 (git-status) are listed as mismatched until
// recompiled. `norte:plugin` does NOT bump: none of its interfaces changes
// name, only the `norte-columns` world's import does, and that does not touch
// previewers.
package norte:location@0.2.0;

/// BOUNDED read under a location the host opened and confined
/// (`openat2(RESOLVE_BENEATH)` in `norte-vfs-local`). Everything that fails
/// here returns a readable `string`: the guest does not distinguish
/// operating-system causes, and has no reason to.
interface location {
    /// What an entry is. Coarse on purpose.
    enum entry-kind { file, dir, symlink, other }

    /// What `stat` returns: exactly the fields git's index keeps. Comparing
    /// only `mtime` is how a change made within the same second gets lost, so
    /// `ctime`, `ino` and `dev` come along too.
    record meta {
        kind: entry-kind,
        size: u64,
        mtime-sec: s64,
        mtime-nsec: u32,
        ctime-sec: s64,
        ctime-nsec: u32,
        ino: u64,
        dev: u64,
        mode: u32,
    }

    /// An entry of a listing. `name` goes in BYTES: hard rule 1 does not stop
    /// applying just because the path crosses an ABI.
    record dirent {
        name: list<u8>,
        kind: entry-kind,
    }

    /// Reads a file under the location. `rel` is relative and in bytes; a `..`
    /// that escapes, an absolute path or a final symlink are an error, not
    /// content.
    read: func(token: string, rel: list<u8>) -> result<list<u8>, string>;

    /// Like `read`, but at most the first `max` bytes: what a header
    /// needs. The host reads and CHARGES only what it returns, so
    /// a column over a hundred videos costs a hundred headers and not a
    /// hundred videos. A file shorter than `max` arrives whole; the guest
    /// cannot tell "it fit" from "it got cut" except via `stat`, and has no
    /// reason to.
    read-prefix: func(token: string, rel: list<u8>, max: u64) -> result<list<u8>, string>;

    /// `lstat` of an entry under the location (the symlink is NOT followed).
    stat: func(token: string, rel: list<u8>) -> result<meta, string>;

    /// Lists a directory under the location. `.` and `..` do not come out.
    ///
    /// It is called `list-dir` and not `list` because `list` is a reserved
    /// word in WIT (it is the `list<T>` type constructor), and the parser
    /// stops there.
    list-dir: func(token: string, rel: list<u8>) -> result<list<dirent>, string>;
}
