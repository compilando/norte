// `norte:panel` (phase 3 of the 2026-09-15 program): a WHOLE PANEL painted
// by a plugin — a layout slot whose content a guest describes.
//
// SEPARATE package from `norte:plugin`, for the same reason as
// `norte:thumbnail` and `norte:renamer` (ADR 0094): the host serves ONE
// version of each package, so bumping `norte:plugin` would invalidate every
// installed guest, and none of them paint panels. A new package debuts its
// own version and touches nobody else.
//
// The guest does not draw: it DESCRIBES. It sends styled lines of spans and
// a list of clickable zones, and each zone names a catalog COMMAND. Never
// a free-form action: what a click on a plugin panel can do is exactly what
// the reader could do with a key, so policy stays intact (hard rule 9) and
// dispatch is the usual one.
//
// It also receives no raw keys. What reaches it is the COMMAND the keymap
// already resolved: a plugin cannot bind `ctrl+s` on its own nor read what
// the reader types in another panel.
package norte:panel@0.1.0;

interface panel {
    /// A styled text span, TWIN of `norte:plugin`'s `span`.
    ///
    /// Redeclared instead of imported because they are different packages
    /// and WIT does not share types between them; the fields are the same
    /// on purpose, so the host converts it to the SAME `StyledSpan` that
    /// styled previews already use and both surfaces paint it with code
    /// that already exists.
    ///
    /// `role` is a semantic theme name (`title`, `warning`, …): if it is
    /// not in the closed set, it is silently ignored and the raw color is
    /// kept — a plugin does not widen the theme's vocabulary. `fg`/`bg`
    /// are the fallback; when there is a role, the role wins (ADR 0037).
    record span {
        text: string,
        role: option<string>,
        fg: option<tuple<u8, u8, u8>>,
        bg: option<tuple<u8, u8, u8>>,
    }

    /// A frame cell: row and column WITHIN the panel, zero-based.
    record cell {
        row: u16,
        col: u16,
    }

    /// A clickable zone: from `col` and `width` cells wide, on `row`.
    ///
    /// The command is one from the catalog (`nav.enter`, `pane.reload`, …).
    /// One that does not exist is not a host error: normal dispatch
    /// already knows how to say "that can't be done here", with the same
    /// sentence as for a key.
    ///
    /// A multi-row zone is described with one zone PER ROW: this way there
    /// is no need to define what happens when two rectangles overlap in
    /// two dimensions, and the host can resolve a click with one
    /// comparison.
    record hit {
        row: u16,
        col: u16,
        width: u16,
        command: string,
        arg: option<string>,
    }

    /// What the guest returns: the frame and its state.
    ///
    /// `state` is OPAQUE bytes the host stores per slot and returns on the
    /// next call. The host does not interpret them — they are not its —
    /// and caps them: a guest that wants to remember more than fits loses
    /// it between repaints, which is its own problem and not the host's.
    record frame {
        lines: list<list<span>>,
        hits: list<hit>,
        state: list<u8>,
    }

    /// What the guest is told about where it is painting.
    ///
    /// `cursor-name` is the name of the row under the panel's keyboard
    /// cursor, already in paintable text — not a path: whoever wants to
    /// read the disk uses `norte:location`, which is the capability that
    /// is granted and audited.
    record panel-context {
        cols: u32,
        rows: u32,
        lang: string,
        cursor-name: option<string>,
    }

    /// Why it is being called.
    ///
    /// `refresh` is a repaint with no gesture behind it (the directory,
    /// the cursor, or the size changed). `click` carries the cell.
    /// `command` carries the command the keymap resolved while the panel
    /// had the keyboard.
    variant panel-event {
        refresh,
        click(cell),
        command(string),
    }

    /// The READ permission, as it crosses to the guest: an opaque token
    /// the host mints for this call and retires when done, and the prefix
    /// stating which part of the root the reader is looking at.
    ///
    /// Twin of `norte:plugin`'s, redeclared because WIT does not share
    /// types across packages. Both fields are needed for the same reason
    /// as there: with a `location-root-marker` in the manifest, the opened
    /// root is the ANCESTOR containing the marker (`.git`), not the
    /// visible directory, and without `prefix` the guest would not know —
    /// nor be able to find out — where it stands within it.
    ///
    /// `none` = no permission: the panel paints with what the context
    /// tells it. It is an honest degradation, not an error.
    record location-ref {
        token: string,
        prefix: list<u8>,
    }

    /// Paints panel `kind` (the one declared in
    /// `[[contributions.panel]]`).
    ///
    /// An `Err` brings nothing down: the host keeps the last frame and
    /// says so. Same if the guest is slow — the cosmetic degrades, it
    /// never blocks.
    render: func(
        kind: string,
        context: panel-context,
        location: option<location-ref>,
        state: list<u8>,
        event: panel-event,
    ) -> result<frame, string>;
}

/// World of a panel plugin: exposes `panel` and imports logging, its
/// config and `norte:location`.
///
/// `location` because a useful panel almost always reads something about
/// where it is — the `.git` branch, a `README` — and that is the SCOPED
/// capability that is already used for it: consented prefix, call budget
/// and auditing. Without it, a panel could only paint what the context
/// tells it.
world norte-panel {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    import norte:location/location@0.2.0;
    export panel;
}
