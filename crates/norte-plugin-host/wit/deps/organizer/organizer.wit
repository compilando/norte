// `norte:organizer` (phase 8 of the WOW program): a plugin PROPOSES where to
// move each file — with subdirectories — and the core runs it as a batch:
// creates the missing folders and moves, all under one `batch_id`, with
// review in front of the human, `plan_hash`, journal and a single undo.
//
// It is `norte:renamer`'s sibling and the difference fits in one sentence:
// there the destination is a NAME and here it is a RELATIVE PATH. That is
// what turns a rename into a reorganization, and also what forces
// validation: a `..` in that destination is a write outside the directory
// the human was looking at, so the host checks it BEFORE creating
// anything. A guest cannot skip it — its proposal is text, and the core
// runs it through the same gate as an AI model's.
//
// Its own package and not one more interface of `norte:renamer`, for the
// same reason that one is of `norte:plugin` (ADR 0041 decision 4, ADR
// 0094): the version travels inside the name of each interface, and a
// change here must not invalidate third-party renamers. It starts at
// 0.1.0 and bumps on its own.
package norte:organizer@0.1.0;

/// An ORGANIZATION proposer. Receives the names the batch acts on — what
/// is marked, or what is pointed at — and returns where each one goes. Only
/// those: a name that does not appear stays where it is.
interface organizer {
    /// The location the host opened for this call (the names' directory),
    /// for a guest approved for the `location` capability: the opaque
    /// token used to read it (`norte:location`) and the `prefix` relative
    /// to the opened root. `none` = it was not approved, or the host could
    /// not open it. A guest that receives `none` still has to keep
    /// answering — with only what it knows from the name — instead of
    /// failing.
    record location-ref {
        token: string,
        prefix: list<u8>,
    }

    /// A move: the name there is and where it goes.
    ///
    /// `proposed-rel` is RELATIVE to the batch's directory, with `/` as
    /// separator, and ends in the file's new name:
    /// `invoices/2026/march.pdf`. What the host REJECTS, and with it the
    /// whole plan: being absolute, carrying a `.` or `..` segment, being
    /// empty, having empty segments (`a//b`, or ending in `/`), or exceeding
    /// the depth cap. It is not a recommendation: it is checked.
    ///
    /// Text and not bytes, as in the renamer: a plan move travels
    /// UTF-8 over the protocol, so a name that is not UTF-8 cannot be part
    /// of a batch — the host sets it aside BEFORE calling.
    record proposal {
        current: string,
        proposed-rel: string,
    }

    /// `id` is the manifest's organizer that was requested (a plugin can
    /// contribute several: "by year", "by type"). An `err` is a sentence
    /// for the reader: the plan does not open and it says why.
    plan: func(id: string, location: option<location-ref>,
               names: list<string>) -> result<list<proposal>, string>;
}

/// The world of an `organizer` plugin: imports the same as `norte-renamer`
/// and exports `organizer`.
world norte-organizer {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    // ALWAYS imported, as in `norte-renamer`: the linker offers it to every
    // guest and what decides whether it SERVES anything is the approved
    // capability.
    import norte:location/location@0.2.0;
    export organizer;
}
