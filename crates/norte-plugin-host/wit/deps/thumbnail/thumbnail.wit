// `norte:thumbnail` (ADR 0107): a THUMBNAIL of a file for the window's
// viewer — a small raster the host paints; the guest only builds it from
// the bytes it receives.
//
// SEPARATE package from `norte:plugin`, not one more interface inside it:
// bumping `norte:plugin` invalidates every installed guest (ADR 0094: the
// host serves ONE version of each package), and none of the existing ones
// implement thumbnails. A new package debuts its own version and touches
// nobody else — the same treatment as `norte:renamer` and `norte:hook`.
//
// What the guest returns is IMAGE BYTES, and that is why the host treats
// them as hostile: it caps the size, requires the declared `mimetype` to
// be one the webview paints (PNG, JPEG, WebP) and that the first bytes
// confirm it, and checks that the declared dimensions match the header
// before they reach a `blob:`. A guest does not choose what gets painted:
// it describes.
package norte:thumbnail@0.1.0;

interface thumbnail {
    /// What it is given: the file's bytes — CAPPED by the host, which
    /// never hands over more than its ceiling — and the largest edge the
    /// thumbnail must not exceed. `mimetype` is the one the host guessed
    /// from the extension.
    record thumb-input {
        mimetype: string,
        content: list<u8>,
        max-edge: u32,
    }

    /// The thumbnail: an encoded image (`image/png`, `image/jpeg` or
    /// `image/webp`) with its dimensions. The host verifies them against
    /// the raster's own header.
    record thumb {
        mimetype: string,
        bytes: list<u8>,
        width: u32,
        height: u32,
    }

    /// Builds the thumbnail, or says why not (`Err`): a format it does
    /// not understand, a truncated file. An `Err` is not a plugin
    /// failure, it is "not for this one"; the viewer falls back to what
    /// it had.
    render: func(input: thumb-input) -> result<thumb, string>;
}

/// World of a thumbnail plugin: exposes `thumbnail` and imports
/// `host-log`/`host-config`. No `location`: it receives the bytes, not a
/// path.
world norte-thumbnail {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    export thumbnail;
}
