// `norte:renamer` (C3 of the plugin plan, ADR 0095): a plugin PROPOSES
// name pairs and the core runs them as a rename batch — the same shape as
// the AI's plan (`ai.rename_plan`) and the template (#310): review with the
// human present, `plan_hash`, journal and undo. What makes the operation
// safe is not where the names came from.
//
// Its own package and not one more interface of `norte:plugin`, for the
// same reason as `norte:location` (ADR 0041 decision 4, ADR 0094): a
// package's version travels inside the name of each interface, and a
// change here must not invalidate third-party previewers. It starts at
// 0.1.0 and bumps on its own.
package norte:renamer@0.1.0;

/// A name proposer. Receives the names the batch acts on — what is
/// marked, or what is pointed at — and returns the `(from, to)` pairs it
/// wants to change. Only those: a name that does not appear stays as is, and
/// an identity pair gets dropped on the host.
interface renamer {
    /// The location the host opened for this call (the names' directory),
    /// for a guest approved for the `location` capability: the opaque
    /// token used to read it (`norte:location`) and the `prefix` relative
    /// to the opened root. `none` = it was not approved, or the host could
    /// not open it. A guest that receives `none` still has to keep
    /// answering — with only what it knows from the name — instead of
    /// failing.
    record location-ref {
        token: string,
        prefix: list<u8>,
    }

    /// A pair: the name there is and the one proposed. Text and not bytes
    /// on purpose: a plan pair travels UTF-8 over the protocol, so a name
    /// that is not UTF-8 cannot be part of a batch — the host sets it
    /// aside BEFORE calling, as it does with the template. (`from` is a
    /// WIT reserved word; hence the names.)
    record proposal {
        current: string,
        proposed: string,
    }

    /// `id` is the manifest's renamer that was requested (a plugin can
    /// contribute several: "by EXIF date", "by ID3 title"). An `err` is a
    /// sentence for the reader: the plan does not open and it says why.
    plan: func(id: string, location: option<location-ref>,
               names: list<string>) -> result<list<proposal>, string>;
}

/// The world of a `renamer` plugin: imports the same as `norte-columns`
/// — logging, config and location — and exports `renamer`.
world norte-renamer {
    import norte:host/host-log@0.1.0;
    import norte:host/host-config@0.1.0;
    // ALWAYS imported, as in `norte-columns`: the linker offers it to every
    // guest and what decides whether it SERVES anything is the approved
    // capability.
    import norte:location/location@0.2.0;
    export renamer;
}
