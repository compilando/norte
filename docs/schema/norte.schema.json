{
  "$defs": {
    "DaemonMode": {
      "description": "Transporte del core (regla 7: solo cambia el transporte).",
      "oneOf": [
        {
          "const": "embedded",
          "description": "Core in-process (default).",
          "type": "string"
        },
        {
          "const": "daemon",
          "description": "Contra el daemon UDS (solo unix, ADR 0011).",
          "type": "string"
        }
      ]
    },
    "DaemonSection": {
      "additionalProperties": false,
      "description": "`[daemon]` de `norte.toml` (ADR 0011). El modo se decide EN EL\nARRANQUE: no participa del hot-reload (cambiar de transporte en\ncaliente = reiniciar).",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DaemonMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "`embedded` (default: arranque instantáneo) o `daemon`."
        },
        "socket": {
          "default": null,
          "description": "Socket del daemon; ausente = el default del OS.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "KeymapSection": {
      "additionalProperties": false,
      "description": "`[keymap]` de `norte.toml`.",
      "properties": {
        "preset": {
          "default": null,
          "description": "Preset base (`orthodox`, `vim`, `cua`). Ausente = capa anterior.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "UiSection": {
      "additionalProperties": false,
      "description": "`[ui]` de `norte.toml`.",
      "properties": {
        "lang": {
          "default": null,
          "description": "Idioma (`es`, `en`). Ausente = negociar del entorno.",
          "type": [
            "string",
            "null"
          ]
        },
        "theme": {
          "default": null,
          "description": "Tema: nombre de preset embebido (`default`, `catppuccin-mocha`,\n`gruvbox-dark`, `nord`) o ruta a un `.toml` propio (ADR 0020). Ausente =\npreset `default`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`norte.toml`: la config general.",
  "properties": {
    "daemon": {
      "$ref": "#/$defs/DaemonSection",
      "description": "Sección del daemon (fase 3 M2)."
    },
    "keymap": {
      "$ref": "#/$defs/KeymapSection",
      "description": "Sección de keymap."
    },
    "ui": {
      "$ref": "#/$defs/UiSection",
      "description": "Sección de UI."
    }
  },
  "title": "NorteToml",
  "type": "object"
}
