{
  "$defs": {
    "RawBinding": {
      "additionalProperties": false,
      "description": "One binding as represented in TOML.",
      "properties": {
        "on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "run": {
          "type": "string"
        }
      },
      "required": [
        "on",
        "run"
      ],
      "type": "object"
    },
    "RawSection": {
      "additionalProperties": false,
      "description": "The three binding lists in a section: `keymap` for presets and\n`prepend_keymap`/`append_keymap` for user layers.",
      "properties": {
        "append_keymap": {
          "items": {
            "$ref": "#/$defs/RawBinding"
          },
          "type": "array"
        },
        "keymap": {
          "items": {
            "$ref": "#/$defs/RawBinding"
          },
          "type": "array"
        },
        "prepend_keymap": {
          "items": {
            "$ref": "#/$defs/RawBinding"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A parsed `keymap.toml` preset or user layer.",
  "properties": {
    "global": {
      "$ref": "#/$defs/RawSection"
    },
    "pane": {
      "$ref": "#/$defs/RawSection"
    },
    "viewer": {
      "$ref": "#/$defs/RawSection"
    }
  },
  "title": "KeymapFile",
  "type": "object"
}
